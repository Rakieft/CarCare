@page "/fuel"
@rendermode InteractiveServer
@attribute [Authorize]
@using CarCare.Data
@using CarCare.Models
@using CarCare.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject CurrentVehicleService CurrentVehicle

<PageTitle>Fuel records - CarCare</PageTitle>

<h1>Fuel records</h1>

@if (loading)
{
    <p><em>Loading...</em></p>
}
else if (vehicle is null)
{
    <div class="alert alert-warning" role="status">
        Set up your vehicle first. <a href="onboarding">Go to Vehicle Setup</a>
    </div>
}
else
{
    <h2 class="h4">@(editing.Id == 0 ? "Add a fill-up" : "Edit fill-up")</h2>

    <EditForm Model="editing" OnValidSubmit="SaveAsync" class="mb-4" style="max-width: 32em;">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="fuel-date" class="form-label">Date</label>
            <InputDate id="fuel-date" class="form-control" @bind-Value="editing.Date" />
        </div>
        <div class="mb-3">
            <label for="fuel-odometer" class="form-label">Odometer (miles)</label>
            <InputNumber id="fuel-odometer" class="form-control" @bind-Value="editing.Odometer" />
        </div>
        <div class="mb-3">
            <label for="fuel-gallons" class="form-label">Gallons</label>
            <InputNumber id="fuel-gallons" class="form-control" @bind-Value="editing.Gallons" />
        </div>
        <div class="mb-3">
            <label for="fuel-cost" class="form-label">Total cost ($)</label>
            <InputNumber id="fuel-cost" class="form-control" @bind-Value="editing.Cost" />
        </div>

        <button type="submit" class="btn btn-primary">@(editing.Id == 0 ? "Add fill-up" : "Save changes")</button>
        @if (editing.Id != 0)
        {
            <button type="button" class="btn btn-secondary ms-2" @onclick="ResetForm">Cancel</button>
        }
    </EditForm>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-success" role="status">@message</div>
    }

    @if (records.Count == 0)
    {
        <p>No fill-ups recorded yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <caption>Fuel history, newest first</caption>
                <thead>
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Odometer</th>
                        <th scope="col">Gallons</th>
                        <th scope="col">Cost</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in records)
                    {
                        <tr>
                            <td>@r.Date.ToString("MMM d, yyyy")</td>
                            <td>@r.Odometer.ToString("N0") mi</td>
                            <td>@r.Gallons.ToString("0.0#")</td>
                            <td>@r.Cost.ToString("C")</td>
                            <td>
                                @if (confirmingDeleteId == r.Id)
                                {
                                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(r.Id)">Confirm delete</button>
                                    <button class="btn btn-sm btn-secondary" @onclick="() => confirmingDeleteId = null">Cancel</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(r)" aria-label="Edit fill-up from @r.Date.ToString("MMM d, yyyy")">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmingDeleteId = r.Id" aria-label="Delete fill-up from @r.Date.ToString("MMM d, yyyy")">Delete</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private Vehicle? vehicle;
    private bool loading = true;
    private List<FuelRecord> records = new();
    private FuelRecord editing = new();
    private int? confirmingDeleteId;
    private string message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        vehicle = await CurrentVehicle.GetAsync();
        await LoadAsync();
        loading = false;
    }

    private async Task LoadAsync()
    {
        if (vehicle is null)
        {
            return;
        }

        records = await Db.FuelRecords
            .AsNoTracking()
            .Where(r => r.VehicleId == vehicle.Id)
            .OrderByDescending(r => r.Date)
            .ThenByDescending(r => r.Odometer)
            .ToListAsync();
    }

    private void Edit(FuelRecord r)
    {
        // Work on a copy so cancelling doesn't change the list.
        editing = new FuelRecord
        {
            Id = r.Id,
            VehicleId = r.VehicleId,
            Date = r.Date,
            Odometer = r.Odometer,
            Gallons = r.Gallons,
            Cost = r.Cost
        };
        message = string.Empty;
    }

    private void ResetForm()
    {
        editing = new FuelRecord();
    }

    private async Task SaveAsync()
    {
        if (vehicle is null)
        {
            return;
        }

        if (editing.Id == 0)
        {
            editing.VehicleId = vehicle.Id;
            Db.FuelRecords.Add(editing);
            message = "Fill-up added.";
        }
        else
        {
            // Only load records that belong to the user's own vehicle.
            var existing = await Db.FuelRecords.FirstOrDefaultAsync(r => r.Id == editing.Id && r.VehicleId == vehicle.Id);
            if (existing is null)
            {
                return;
            }

            existing.Date = editing.Date;
            existing.Odometer = editing.Odometer;
            existing.Gallons = editing.Gallons;
            existing.Cost = editing.Cost;
            message = "Fill-up updated.";
        }

        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();
        editing = new FuelRecord();
        await LoadAsync();
    }

    private async Task DeleteAsync(int id)
    {
        if (vehicle is null)
        {
            return;
        }

        var existing = await Db.FuelRecords.FirstOrDefaultAsync(r => r.Id == id && r.VehicleId == vehicle.Id);
        if (existing is not null)
        {
            Db.FuelRecords.Remove(existing);
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();
            message = "Fill-up deleted.";
        }

        confirmingDeleteId = null;
        await LoadAsync();
    }
}
