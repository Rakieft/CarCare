@page "/maintenance"
@rendermode InteractiveServer
@attribute [Authorize]
@using CarCare.Data
@using CarCare.Models
@using CarCare.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject CurrentVehicleService CurrentVehicle

<PageTitle>Maintenance - CarCare</PageTitle>

<h1>Maintenance records</h1>

@if (loading)
{
    <p><em>Loading...</em></p>
}
else if (vehicle is null)
{
    <div class="alert alert-warning" role="status">
        Set up your vehicle first. <a href="onboarding">Go to Vehicle Setup</a>
    </div>
}
else
{
    <h2 class="h4">@(editing.Id == 0 ? "Add a service" : "Edit service")</h2>

    <EditForm Model="editing" OnValidSubmit="SaveAsync" class="mb-4" style="max-width: 32em;">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="m-type" class="form-label">Service type</label>
            <InputText id="m-type" class="form-control" @bind-Value="editing.Type" placeholder="e.g. Oil change" />
        </div>
        <div class="mb-3">
            <label for="m-desc" class="form-label">Notes (optional)</label>
            <InputText id="m-desc" class="form-control" @bind-Value="editing.Description" />
        </div>
        <div class="mb-3">
            <label for="m-date" class="form-label">Date</label>
            <InputDate id="m-date" class="form-control" @bind-Value="editing.Date" />
        </div>
        <div class="mb-3">
            <label for="m-odo" class="form-label">Odometer (miles)</label>
            <InputNumber id="m-odo" class="form-control" @bind-Value="editing.Odometer" />
        </div>
        <div class="mb-3">
            <label for="m-cost" class="form-label">Cost ($)</label>
            <InputNumber id="m-cost" class="form-control" @bind-Value="editing.Cost" />
        </div>

        <fieldset class="mb-3">
            <legend class="h6">Reminder (optional)</legend>
            <div class="mb-3">
                <label for="m-next-date" class="form-label">Next service date</label>
                <InputDate id="m-next-date" class="form-control" @bind-Value="editing.NextServiceDate" />
            </div>
            <div class="mb-3">
                <label for="m-next-odo" class="form-label">Next service odometer (miles)</label>
                <InputNumber id="m-next-odo" class="form-control" @bind-Value="editing.NextServiceOdometer" />
            </div>
        </fieldset>

        <button type="submit" class="btn btn-primary">@(editing.Id == 0 ? "Add service" : "Save changes")</button>
        @if (editing.Id != 0)
        {
            <button type="button" class="btn btn-secondary ms-2" @onclick="ResetForm">Cancel</button>
        }
    </EditForm>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-success" role="status">@message</div>
    }

    @if (records.Count == 0)
    {
        <p>No maintenance recorded yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <caption>Maintenance history, newest first</caption>
                <thead>
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Service</th>
                        <th scope="col">Odometer</th>
                        <th scope="col">Cost</th>
                        <th scope="col">Next due</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in records)
                    {
                        <tr>
                            <td>@r.Date.ToString("MMM d, yyyy")</td>
                            <td>@r.Type</td>
                            <td>@r.Odometer.ToString("N0") mi</td>
                            <td>@r.Cost.ToString("C")</td>
                            <td>@NextDue(r)</td>
                            <td>
                                @if (confirmingDeleteId == r.Id)
                                {
                                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(r.Id)">Confirm delete</button>
                                    <button class="btn btn-sm btn-secondary" @onclick="() => confirmingDeleteId = null">Cancel</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(r)" aria-label="Edit @r.Type from @r.Date.ToString("MMM d, yyyy")">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmingDeleteId = r.Id" aria-label="Delete @r.Type from @r.Date.ToString("MMM d, yyyy")">Delete</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private Vehicle? vehicle;
    private bool loading = true;
    private List<MaintenanceRecord> records = new();
    private MaintenanceRecord editing = new();
    private int? confirmingDeleteId;
    private string message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        vehicle = await CurrentVehicle.GetAsync();
        await LoadAsync();
        loading = false;
    }

    private async Task LoadAsync()
    {
        if (vehicle is null)
        {
            return;
        }

        records = await Db.MaintenanceRecords
            .AsNoTracking()
            .Where(r => r.VehicleId == vehicle.Id)
            .OrderByDescending(r => r.Date)
            .ThenByDescending(r => r.Odometer)
            .ToListAsync();
    }

    private static string NextDue(MaintenanceRecord r)
    {
        var parts = new List<string>();
        if (r.NextServiceDate is { } d) parts.Add(d.ToString("MMM d, yyyy"));
        if (r.NextServiceOdometer is { } o) parts.Add($"{o:N0} mi");
        return parts.Count == 0 ? "-" : string.Join(" / ", parts);
    }

    private void Edit(MaintenanceRecord r)
    {
        // Work on a copy so cancelling doesn't change the list.
        editing = new MaintenanceRecord
        {
            Id = r.Id,
            VehicleId = r.VehicleId,
            Type = r.Type,
            Description = r.Description,
            Date = r.Date,
            Odometer = r.Odometer,
            Cost = r.Cost,
            NextServiceDate = r.NextServiceDate,
            NextServiceOdometer = r.NextServiceOdometer
        };
        message = string.Empty;
    }

    private void ResetForm()
    {
        editing = new MaintenanceRecord();
    }

    private async Task SaveAsync()
    {
        if (vehicle is null)
        {
            return;
        }

        editing.Type = editing.Type.Trim();

        if (editing.Id == 0)
        {
            editing.VehicleId = vehicle.Id;
            Db.MaintenanceRecords.Add(editing);
            message = "Service added.";
        }
        else
        {
            // Only load records that belong to the user's own vehicle.
            var existing = await Db.MaintenanceRecords.FirstOrDefaultAsync(r => r.Id == editing.Id && r.VehicleId == vehicle.Id);
            if (existing is null)
            {
                return;
            }

            existing.Type = editing.Type;
            existing.Description = editing.Description;
            existing.Date = editing.Date;
            existing.Odometer = editing.Odometer;
            existing.Cost = editing.Cost;
            existing.NextServiceDate = editing.NextServiceDate;
            existing.NextServiceOdometer = editing.NextServiceOdometer;
            message = "Service updated.";
        }

        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();
        editing = new MaintenanceRecord();
        await LoadAsync();
    }

    private async Task DeleteAsync(int id)
    {
        if (vehicle is null)
        {
            return;
        }

        var existing = await Db.MaintenanceRecords.FirstOrDefaultAsync(r => r.Id == id && r.VehicleId == vehicle.Id);
        if (existing is not null)
        {
            Db.MaintenanceRecords.Remove(existing);
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();
            message = "Service deleted.";
        }

        confirmingDeleteId = null;
        await LoadAsync();
    }
}
